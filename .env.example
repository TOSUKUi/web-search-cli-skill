# Configure at least one provider for live searches.
# Multiple keys may be comma-separated: key-1,key-2
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
QUERIT_API_KEY=
PERPLEXITY_API_KEY=
KILOCODE_API_KEY=
YOU_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_API_KEY=
SCRAPERAPI_API_KEY=
# Bright Data direct SERP API (zone Overview tab)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
SEARXNG_INSTANCE_URL=
# Set to 1 only when the SearXNG URL intentionally points to a private/internal host.
SEARXNG_ALLOW_PRIVATE=0

# Optional satellite mode
WSP_SATELLITE_URL=
WSP_SATELLITE_TOKEN=
# Optional bearer authentication for the central server
WSP_SERVER_TOKEN=
# Docker Compose host port (defaults to 8765)
WSP_PUBLISHED_PORT=8765
